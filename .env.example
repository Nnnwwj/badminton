# Backend-only configuration. Copy values into backend/.env and never commit it.
APP_ENV=development
DATABASE_URL=sqlite:///./data/badminton.db

# Configure these before the DeepSeek integration phase.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_PROMPT_VERSION=v1
